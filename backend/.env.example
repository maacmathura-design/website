# Copy to backend/.env and fill in. Never commit backend/.env.
# In production, set these in the host's environment/secret manager instead of a file.

# development | production. Production requires HTTPS, ALLOWED_ORIGINS and all mail variables.
NODE_ENV=development

# Port the enquiry API listens on (5000 is taken by AirPlay Receiver on macOS).
PORT=5050

# Gmail account that sends enquiry emails. Use a Google App Password
# (Google Account > Security > 2-Step Verification > App passwords), not the login password.
EMAIL_USER=
EMAIL_PASS=

# Inbox that receives enquiry emails.
RECIPIENT_EMAIL=

# Comma-separated browser origins allowed to call the API (scheme + host, no path).
# Development defaults to http://localhost:3000. Example for production:
# ALLOWED_ORIGINS=https://www.maacmathura.com,https://maacmathura.com
ALLOWED_ORIGINS=

# Proxies in front of the API (for client IPs and HTTPS detection). Production default: 1.
# TRUST_PROXY=1

# Defaults to true in production. Requests that did not arrive over HTTPS are refused.
# REQUIRE_HTTPS=true

# Serve frontend/build from this process. Default: on when that build exists.
# SERVE_STATIC=false

# Optional tuning (defaults shown).
# ENQUIRY_RATE_LIMIT_MAX=5
# ENQUIRY_RATE_LIMIT_WINDOW_MINUTES=15
# ENQUIRY_DUPLICATE_WINDOW_MINUTES=10
# ENQUIRY_MIN_FILL_SECONDS=2
