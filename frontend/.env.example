# Frontend configuration. REACT_APP_* values are compiled into the public JavaScript bundle:
# never put secrets here. Copy the block you need into the matching (git-ignored) file.

# --- Local development: frontend/.env.development.local -------------------------------------
# Leave unset to use the dev-server proxy (src/setupProxy.js: /api -> http://localhost:5050;
# override the target with API_PROXY_TARGET).
# Or call the API directly (the API must list http://localhost:3000 in ALLOWED_ORIGINS,
# which is its development default):
# REACT_APP_API_URL=http://localhost:5050

# --- Production: frontend/.env.production.local, or the build server's environment ----------
# Empty = same origin: the web server routes /api/* to the backend (recommended).
# Otherwise the public HTTPS URL of the API; `npm run build` refuses http:// and localhost.
# REACT_APP_API_URL=https://api.example.com
REACT_APP_API_URL=

# Public site origin, no trailing slash. Used only to write sitemap.xml and the Sitemap line
# in robots.txt at build time. Canonical and social URLs in the browser use the origin
# that is actually serving the page.
# REACT_APP_SITE_URL=https://example.com
