{
  "name": "maac-mathura",
  "version": "1.0.0",
  "private": true,
  "description": "MAAC Mathura website and admission enquiry API, deployed as one Node.js app.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm ci --prefix frontend && npm run build --prefix frontend",
    "start": "node backend/server.js",
    "dev:web": "npm start --prefix frontend",
    "dev:api": "npm run dev --prefix backend",
    "test:api": "npm test --prefix backend"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "nodemailer": "^10.6.0"
  }
}
